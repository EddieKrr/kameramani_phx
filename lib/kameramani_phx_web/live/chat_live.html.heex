<div class="flex h-full w-full bg-[#060606] text-gray-100 overflow-hidden font-sans">
  <aside class="w-[70px] xl:w-64 bg-[#0e0e10] border-r border-white/5 flex flex-col transition-all duration-300">
    <div class="flex-1 overflow-y-auto px-2 space-y-4 py-4">
      <div class="hidden xl:block px-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest">
        Followed Channels
      </div>

      <div class="flex-1 overflow-y-auto px-2 space-y-2 py-4 custom-scrollbar">
        <.sidebar_item
          :for={stream <- @recommended_streams}
          name={stream.name}
          game={stream.game}
          viewer_count={to_string(stream.viewer_count)}
          src={stream.src}
          active={stream.name == @streamer_name}
          show_details={@left_sidebar_open}
        />
      </div>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 bg-[#0e0e10] overflow-y-auto relative">
    <%= if !@chat_open do %>
      <div class="absolute top-4 right-4 z-50">
        <button
          phx-click="toggle_chat"
          class="p-2 bg-[#18181b]/80 backdrop-blur rounded hover:bg-[#18181b] border border-white/5 text-[#efeff1] shadow-lg flex items-center gap-2 group transition-all"
        >
          <.svg variant="chat-bubble-left" class="w-5 h-5 text-[#adadb8] group-hover:text-white" />
        </button>
      </div>
    <% end %>

    <div class="w-full aspect-video bg-black relative group shadow-2xl">
      <%= if @is_live do %>
        <div id="video-container" phx-update="ignore" class="w-full h-full">
          <video
            id="video-player"
            phx-hook="VideoPlayer"
            data-hls-url={~p"/live/#{@stream_id}/index.m3u8"}
            class="w-full h-full object-contain"
            controls
            autoplay
            muted
            playsinline
          >
          </video>
        </div>
        
        <div class="absolute top-4 left-4 flex items-center gap-2 pointer-events-none">
          <span class="bg-[#eb0400] text-white text-[12px] font-bold px-2 py-0.5 rounded shadow-lg">
            LIVE
          </span>
          <span class="bg-black/60 backdrop-blur-md text-white text-[12px] font-bold px-2 py-0.5 rounded flex items-center gap-1.5">
            <.svg variant="user" class="h-3 w-3 text-[#eb0400]" />
            <span id="video-viewer-count" phx-hook="AnimateCount">{@viewer_count}</span>
          </span>
          <span class="bg-black/60 backdrop-blur-md text-white text-[12px] font-bold px-2 py-0.5 rounded" id="video-uptime" phx-update="ignore" phx-hook="UptimeTimer" data-start={@stream_started_at} data-is-live={to_string(@is_live)}>
            0:00:00
          </span>
        </div>
      <% else %>
        <div class="absolute inset-0 flex items-center justify-center bg-[#18181b]">
          <div class="text-center">
            <div class="relative inline-block mb-4">
              <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center">
                <.svg variant="camera-slash" class="h-10 w-10 text-[#adadb8]" />
              </div>
            </div>
            <p class="text-[#adadb8] font-medium tracking-tight">
              <span class="text-[#efeff1] font-bold">{@streamer_name}</span> is currently offline.
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="p-5 md:p-8 shrink-0">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <.link navigate={~p"/users/profile/#{@streamer_name}"} class="relative shrink-0 group">
            <div class={"w-16 h-16 rounded-full p-0.5 transition-transform group-hover:scale-105 " <> (if @is_live, do: "bg-[#eb0400]", else: "bg-white/10")}>
              <img class="w-full h-full rounded-full object-cover border-2 border-[#0e0e10]" src={@streamer_profile_picture} alt={@streamer_name} />
            </div>
            <%= if @is_live do %>
              <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-[#eb0400] text-white text-[10px] font-bold px-1.5 py-0.5 rounded-sm border-2 border-[#0e0e10] leading-none tracking-wide">
                LIVE
              </div>
            <% end %>
          </.link>

          <div class="flex flex-col">
            <div class="flex items-center gap-2 mb-1">
              <.link navigate={~p"/users/profile/#{@streamer_name}"} class="text-xl font-bold text-[#efeff1] tracking-tight hover:text-[#bf94ff] transition-colors">
                {@streamer_name}
              </.link>
            </div>
            <h2 class="text-[15px] font-medium text-[#efeff1] tracking-tight mb-2 truncate max-w-2xl">
              {@stream_name}
            </h2>

            <div class="flex items-center gap-2 mb-3">
              <span class="text-[#bf94ff] hover:underline cursor-pointer font-semibold text-sm">
                {@category_name}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
              <%= for tag <- @tags do %>
                <span class="bg-[#26262c] hover:bg-[#323239] transition-colors cursor-pointer text-[#adadb8] font-semibold text-[12px] px-3 py-0.5 rounded-full">
                  {tag}
                </span>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex flex-col items-end gap-4">
          <div class="flex items-center gap-6 text-[#eb0400] font-bold text-sm">
            <div class="flex items-center gap-1.5">
              <.svg variant="user" class="w-4 h-4" />
              <span id="profile-viewer-count" phx-hook="AnimateCount">{@viewer_count}</span>
            </div>
            <div class="text-[#adadb8] font-medium flex items-center gap-1.5" id="profile-uptime" phx-update="ignore" phx-hook="UptimeTimer" data-start={@stream_started_at} data-is-live={to_string(@is_live)}>
              <.svg variant="clock" class="w-4 h-4" />
              <span>0:00:00</span>
            </div>
          </div>

          <%= if @current_user.user && @current_user.user.id != @streamer_id do %>
            <button
              phx-click="toggle_follow"
              class={"px-4 py-1.5 rounded font-bold text-sm transition-colors flex items-center gap-2 shadow " <> 
                if(@is_following, do: "bg-gray-700 hover:bg-gray-600 text-white", else: "bg-[#bf94ff] hover:bg-[#a970ff] text-black")}
            >
              <%= if @is_following do %>
                <.svg variant="heart-solid" class="w-4 h-4 text-red-500" /> Unfollow
              <% else %>
                <.svg variant="heart" class="w-4 h-4" /> Follow
              <% end %>
            </button>
          <% else %>
            <%= if !@current_user.user do %>
              <button phx-click="toggle_follow" class="bg-[#bf94ff] hover:bg-[#a970ff] text-black px-4 py-1.5 rounded font-bold text-sm transition-colors flex items-center gap-2 shadow">
                <.svg variant="heart" class="w-4 h-4" /> Follow
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </main>

  <%= if @chat_open do %>
    <aside class="w-80 bg-[#18181b] border-l border-white/5 flex flex-col shadow-[-10px_0_30px_rgba(0,0,0,0.5)] z-20 transition-all duration-300">
      <div class="h-12 flex items-center justify-between px-3 border-b border-white/5 shrink-0">
        <button
          phx-click="toggle_chat"
          class="p-1 rounded hover:bg-white/10 text-[#adadb8] transition-colors"
          title="Collapse"
        >
          <.svg variant="chevron-right" class="w-5 h-5" />
        </button>
        <span class="text-[12px] font-bold uppercase tracking-wider text-[#efeff1]">
          Stream Chat
        </span>
        <div class="flex items-center gap-1 text-[#adadb8]">
          <.svg variant="user" class="h-4 w-4" />
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-3 space-y-1.5 custom-scrollbar" id="chat-messages" phx-update="stream" phx-hook="ChatScroll">
        <div :for={{dom_id, msg} <- @streams.messages} id={dom_id} class="group text-[13px] leading-relaxed break-words">
          <span class="font-bold cursor-pointer hover:underline" style={"color: #{msg.user.chat_color || "#6366f1"}"}><%= msg.user.username %></span><span class="text-white">:</span>
          <span class="text-[#efeff1] ml-1"><%= msg.body %></span>
        </div>
      </div>

      <div class="p-4 bg-[#18181b] border-t border-white/5 shrink-0">
        <.form for={@form} phx-change="validate" phx-submit="send_message" class="space-y-3">
          <div class="bg-[#0e0e10] border-2 border-transparent focus-within:border-[#bf94ff]/50 rounded-lg p-2 transition-colors">
            <.input
              field={@form[:ch_message]}
              placeholder="Send a message..."
              autocomplete="off"
              class="w-full bg-transparent border-none focus:ring-0 text-[#efeff1] text-sm p-0 mb-2 resize-none"
            />
            <div class="flex justify-between items-center mt-2">
              <div class="flex items-center gap-2">
                <div
                  class="w-3 h-3 rounded-full shadow-sm"
                  style={"background-color: #{@user_color}"}
                >
                </div>
                <span class="text-[11px] font-bold text-[#adadb8] truncate max-w-[100px]">
                  {@username}
                </span>
              </div>
              <button
                type="submit"
                class="bg-[#bf94ff] hover:bg-[#a970ff] text-black text-[12px] font-bold py-1.5 px-4 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                disabled={String.trim(@form[:ch_message].value || "") == ""}
              >
                Chat
              </button>
            </div>
          </div>
        </.form>
      </div>
    </aside>
  <% end %>
</div>
