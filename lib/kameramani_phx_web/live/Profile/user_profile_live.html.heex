<div class="min-h-screen bg-[#0e0e10]">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="aspect-video bg-black w-full rounded-2xl mb-8 border border-white/10"></div>
    <.profile_header
      username={@user.username}
      name={@user.name}
      avatar_url={@avatar_url}
      is_live={@is_live}
    />

  </div>
  <div class="mt-8">
    <.about_section
      email={@user.email}
      member_since={@time}
    />
  </div>
</div>
