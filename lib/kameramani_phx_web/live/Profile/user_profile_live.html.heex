<div class="min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="aspect-video relative bg-black w-full rounded-2xl mb-8 border border-white/10">
      <%= if @is_live do %>
        <%!-- THE LIVE PLAYER --%>
        <div class="absolute inset-0 w-full h-full">
          <div class="relative w-full h-full group">
            <video
              id="video-player"
              phx-hook="VideoPlayer"
              data-hls-url={~p"/live/#{@stream_id}/index.m3u8"}
              class="w-full h-full object-contain"
              autoplay
              muted
              playsinline
            >
            </video>

            <div class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded uppercase tracking-widest animate-pulse">
              Live
            </div>
          </div>
        </div>
      <% else %>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
          <div class="bg-slate-800/50 p-8 rounded-full mb-4 border border-white/5">
            <.svg variant="digicam" class="h-16 w-16 text-slate-500" />
          </div>
          <h3 class="text-2xl font-title font-bold text-white uppercase tracking-tight">
            {@user.username} is currently offline
          </h3>
          <p class="text-slate-400 mt-2">Check out their past VODs below!</p>
        </div>
      <% end %>

      <div class="absolute bottom-0 ml-4">
        <.profile_header
          username={@user.username}
          name={@user.name}
          avatar_url={@avatar_url}
          is_live={@is_live}
          is_verified={@user.is_verified}
        />
      </div>
    </div>
    <div class="flex">
      <.profile_tab
        patch={~p"/users/profile/#{@user.username}/home"}
        label="Home"
        is_active={@active_tab == "home"}
      />
      <.profile_tab
        patch={~p"/users/profile/#{@user.username}/about"}
        label="About"
        is_active={@active_tab == "about"}
      />
      <.profile_tab
        patch={~p"/users/profile/#{@user.username}/videos"}
        label="Videos"
        is_active={@active_tab == "videos"}
      />
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[#d8d8dd]">
          Followers: {@follower_count}
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[#d8d8dd]">
          Following: {@following_count}
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[#d8d8dd]">
          Subscribers: {@subscriber_count}
        </span>
      </div>

      <div class="flex items-center gap-2">
        <%= if @current_user.user && @current_user.user.id == @user.id && !@user.is_verified do %>
          <%= if @verification_request && @verification_request.status == "pending" do %>
            <div class="flex items-center gap-2 px-4 py-1.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20 text-sm font-bold shadow-sm">
              <.svg variant="clock" class="w-4 h-4" /> Verification Pending
            </div>
          <% else %>
            <button
              phx-click="open_verification_modal"
              class="flex items-center gap-2 px-4 py-1.5 rounded bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold transition-all shadow-lg hover:shadow-blue-500/25"
            >
              <.svg variant="check-badge" class="w-4 h-4" /> Get Verified
            </button>
          <% end %>
        <% end %>

        <%= if @current_user.user && @current_user.user.id != @user.id do %>
          <button
            phx-click="toggle_follow"
            class={"px-4 py-1.5 rounded font-bold text-sm transition-colors flex items-center gap-2 shadow " <>
                if(@is_following, do: "bg-gray-700 hover:bg-gray-600 text-white", else: "bg-indigo-400 hover:bg-indigo-500 text-black")}
          >
            <%= if @is_following do %>
              <.svg variant="check" class="w-4 h-4 text-blue-500" /> Unfollow
            <% else %>
              <.svg variant="plus" class="w-4 h-4" /> Follow
            <% end %>
          </button>
          <button
            phx-click="open_subscribe_modal"
            class={"px-4 py-1.5 rounded font-bold text-sm transition-colors flex items-center gap-2 shadow " <>
                if(@is_subscribed, do: "bg-emerald-700 hover:bg-emerald-600 text-white", else: "glass-button")}
          >
            <.svg variant="heart" class="w-4 h-4" />
            <%= if @is_subscribed do %>
              Manage Sub
            <% else %>
              Subscribe
            <% end %>
          </button>
        <% else %>
          <%= if !@current_user.user do %>
            <button
              phx-click="toggle_follow"
              class="bg-[#bf94ff] hover:bg-[#a970ff] text-black px-4 py-1.5 rounded font-bold text-sm transition-colors flex items-center gap-2 shadow"
            >
              <.svg variant="heart" class="w-4 h-4" /> Follow
            </button>
            <button
              phx-click="open_subscribe_modal"
              class="glass-button"
            >
              <.svg variant="heart" class="w-4 h-4" /> Subscribe
            </button>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="mt-8">
      <%= case @active_tab do %>
        <% "about" -> %>
          <.about_section
            username={@user.username}
            email={@user.email}
            member_since={@time}
            bio={@user.bio}
            social_accounts={@social_accounts}
          />
        <% "videos" -> %>
          <h4 class="font-title text-3xl capitalize text-indigo-300">
            Watch {@user.username}'s Past Streams
          </h4>
          <.video_section vods={@vods} />
        <% "home" -> %>
          <.home_section />
      <% end %>
    </div>
  </div>
</div>

<%= if @show_subscribe_modal do %>
  <div class="fixed inset-0 z-100 flex items-center justify-center  bg-black/70 p-4">
    <div class="w-full max-w-xl rounded-2xl border-2  glass-pane p-6 shadow-2xl">
      <div class="mb-5 flex items-start justify-between">
        <div>
          <h3 class="text-xl font-bold text-white capitalize">Subscribe to {@user.username}</h3>
          <p class="text-sm text-[#adadb8]">
            Choose a renewal tier.
          </p>
        </div>
        <button
          phx-click="close_subscribe_modal"
          class="rounded-md p-1 text-[#adadb8] hover:bg-white/10"
        >
          <.svg variant="x" class="h-5 w-5" />
        </button>
      </div>

      <div class="grid gap-3">
        <button
          :for={option <- @tier_options}
          phx-click="select_tier"
          phx-value-tier={option.tier}
          class={[
            "w-full rounded-xl border px-4 py-3 text-left transition-colors",
            @selected_tier == option.tier && "border-blue-300 bg-blue-300/10",
            @selected_tier != option.tier && "border-white/10 bg-white/5 hover:bg-white/10"
          ]}
        >
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-white">
                {option.tier} month{if option.tier > 1, do: "s", else: ""}
              </p>
              <p class="text-xs text-[#adadb8]">
                USD {option.amount_usd} • KES {option.amount_kes}
              </p>
            </div>
            <%= if @selected_tier == option.tier do %>
              <span class="rounded-full bg-blue-300 px-2 py-0.5 text-xs font-bold text-black">
                Selected
              </span>
            <% end %>
          </div>
        </button>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <button
          phx-click="close_subscribe_modal"
          class="rounded-lg border border-white/10 px-4 py-2 text-sm font-semibold text-[#d2d2da] hover:bg-white/5"
        >
          Cancel
        </button>
        <button
          phx-click="subscribe_to_tier"
          class="glass-button"
        >
          Confirm Subscription
        </button>
      </div>
    </div>
  </div>
<% end %>

<%= if @show_verification_modal do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-slate-900 p-8 shadow-2xl relative overflow-hidden">
      <!-- Background glow -->
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl"></div>

      <div class="relative z-10">
        <div class="flex items-start justify-between mb-8">
          <div>
            <h3 class="text-3xl font-title font-extrabold text-white uppercase tracking-tight italic">
              Verification Request
            </h3>
            <p class="text-slate-400 mt-2">
              Link your social accounts and submit for verification.
            </p>
          </div>
          <button
            phx-click="close_verification_modal"
            class="p-2 hover:bg-white/5 rounded-full text-slate-400 transition-colors"
          >
            <.svg variant="x" class="h-6 w-6" />
          </button>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Social Link Form -->
          <div class="space-y-6">
            <h4 class="text-sm font-bold text-blue-400 uppercase tracking-widest">
              Add Social Account
            </h4>
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                  Platform
                </label>
                <div class="grid grid-cols-3 gap-2">
                  <button
                    :for={platform <- @social_platforms}
                    phx-click="select_platform"
                    phx-value-platform={platform.id}
                    class={[
                      "flex flex-col items-center gap-2 p-3 rounded-xl border transition-all",
                      @selected_platform == platform.id &&
                        "bg-blue-600/20 border-blue-500 text-blue-400",
                      @selected_platform != platform.id &&
                        "bg-white/5 border-white/5 text-slate-400 hover:bg-white/10"
                    ]}
                  >
                    <.svg variant={platform.icon} class="h-6 w-6" />
                    <span class="text-[10px] font-bold uppercase tracking-tighter">
                      {platform.name}
                    </span>
                  </button>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                  Username
                </label>
                <div class="relative group">
                  <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-mono text-sm">
                    {Enum.find(@social_platforms, &(&1.id == @selected_platform)).prefix}
                  </div>
                  <input
                    type="text"
                    phx-keyup="update_social_username"
                    value={@social_username}
                    placeholder="username"
                    class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pr-4 text-white focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all"
                    style={"padding-left: #{String.length(Enum.find(@social_platforms, &(&1.id == @selected_platform)).prefix) * 0.5 + 1}rem"}
                  />
                </div>
              </div>

              <button
                phx-click="add_social_account"
                class="w-full py-3 rounded-xl bg-white text-black font-bold uppercase tracking-wider hover:bg-slate-200 transition-all flex items-center justify-center gap-2"
              >
                <.svg variant="plus" class="h-5 w-5" /> Add Link
              </button>
            </div>
          </div>
          
<!-- Linked Accounts List -->
          <div class="flex flex-col h-full">
            <h4 class="text-sm font-bold text-blue-400 uppercase tracking-widest mb-6">
              Linked Accounts
            </h4>
            <div class="flex-1 space-y-3 overflow-y-auto max-h-64 pr-2 custom-scrollbar">
              <%= if Enum.empty?(@social_accounts) do %>
                <div class="h-full flex flex-col items-center justify-center text-center opacity-50 grayscale">
                  <.svg variant="link" class="h-12 w-12 text-slate-600 mb-2" />
                  <p class="text-xs text-slate-500 uppercase font-bold">No accounts linked yet</p>
                </div>
              <% else %>
                <div
                  :for={social <- @social_accounts}
                  class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 group"
                >
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-black/40 flex items-center justify-center">
                      <.svg variant={social.platform} class="h-4 w-4 text-blue-400" />
                    </div>
                    <div>
                      <p class="text-xs font-bold text-white uppercase tracking-tighter">
                        {social.platform}
                      </p>
                      <p class="text-[10px] text-slate-500 truncate max-w-[120px]">
                        @{social.username}
                      </p>
                    </div>
                  </div>
                  <button
                    phx-click="remove_social_account"
                    phx-value-id={social.id}
                    class="p-2 text-slate-600 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100"
                  >
                    <.svg variant="trash" class="h-4 w-4" />
                  </button>
                </div>
              <% end %>
            </div>

            <div class="mt-8 pt-6 border-t border-white/5">
              <button
                phx-click="request_verification"
                disabled={Enum.empty?(@social_accounts)}
                class="w-full py-4 rounded-xl bg-blue-600 disabled:bg-slate-800 disabled:text-slate-500 text-white font-title font-extrabold uppercase italic tracking-tighter text-xl hover:bg-blue-500 transition-all shadow-xl shadow-blue-900/20"
              >
                Submit Request
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
