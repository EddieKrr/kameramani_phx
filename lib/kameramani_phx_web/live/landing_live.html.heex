<div
  class="flex h-[100%] overflow-hidden gap-2 mx-auto"
  style="width: 95%;"
>
  <div class="glass-pane w-64 bg-transparent border-r-2 border-r-slate-700 shrink-0 sticky top-0 h-screen overflow-y-auto p-4 custom-scrollbar">
    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4 px-2">
      Recommended Channels
    </h2>
    <div class="space-y-1">
      <.sidebar_item
        :for={stream <- @recommended_streams}
        name={stream.name}
        game={stream.game}
        viewer_count={to_string(stream.viewer_count)}
        src={stream.src}
        is_verified={stream.is_verified}
        navigate={~p"/watch/#{stream.name}"}
      />
    </div>
  </div>

  <div class="flex-1 glass-pane overflow-y-auto">
    <div class="relative w-full aspect-video max-h-[500px] glass-pane shadow-xl mb-6 ">
      <div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-b from-transparent to-black pointer-events-none rounded-3xl">
        <div class="flex absolute bottom-4 left-4">
          <.sidebar_item
            name="Jleel"
            game="Sims 4"
            viewer_count="5000"
            src="https://ui-avatars.com/api/?background=random"
            navigate={~p"/watch/Jleel"}
          />
        </div>
      </div>

      <div class="lv-ind absolute top-4 left-4 z-10 bg-red-950 rounded-full px-2 animate-pulse uppercase text-amber-50">
        Live
      </div>
    </div>

    <div class="px-6 pb-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6">
        <.card
          :for={card <- @streams_data}
          id={card.id}
          stream_name={card.stream_name}
          streamer={card.streamer}
          category={card.category}
          tags={card.tags}
          viewer_count={card.viewer_count}
          avatar={card.avatar}
          is_live={card.is_live}
          is_verified={card.is_verified}
          thumbnail_url={card.thumbnail_url}
        />
      </div>
    </div>
  </div>
</div>
