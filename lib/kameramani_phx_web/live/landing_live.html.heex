<div
  class="flex relative gap-2 mx-auto"
  style="width: 95%;"
>
  <div class="glass-pane w-64 self-start border-r-2 border-r-slate-700 shrink-0 sticky top-2 h-[600px] overflow-y-auto p-4 custom-scrollbar">
    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4 px-2">
      Recommended Channels
    </h2>
    <div class="space-y-1">
      <.sidebar_item
        :for={stream <- @recommended_streams}
        name={stream.name}
        game={stream.game}
        viewer_count={to_string(stream.viewer_count)}
        src={stream.src}
        is_verified={stream.is_verified}
        navigate={~p"/watch/#{stream.name}"}
      />
    </div>
  </div>
  
  <div class="flex-1 glass-pane overflow-y-auto overflow-x-hidden">
    <!-- Hero Carousel Section -->
    <section class="w-full bg-black/20 border-b border-white/5 overflow-hidden rounded-3xl">
      <div class="relative w-full h-[300px] sm:h-[400px] lg:h-[550px] flex items-center justify-center">
        <%= if length(@streams_data) > 0 do %>
          <!-- Carousel Container -->
          <div class="relative w-full h-full flex items-center justify-center">
            <%= for {stream, index} <- Enum.with_index(@streams_data) do %>
              <%
                # Calculate position relative to carousel_index
                total = length(@streams_data)
                diff = index - @carousel_index
                
                # Handle wrapping for 3D effect (showing prev and next)
                diff = cond do
                  diff > total / 2 -> diff - total
                  diff < -total / 2 -> diff + total
                  true -> diff
                end

                # Determine classes based on position
                {pos_classes, is_active} = case diff do
                  0 -> 
                    {"z-30 scale-100 opacity-100 translate-x-0 shadow-[0_20px_50px_rgba(0,0,0,0.8)]", true}
                  -1 -> 
                    {"z-10 scale-[0.85] opacity-50 -translate-x-[45%] blur-[2px] brightness-50 cursor-pointer hover:opacity-70 hover:brightness-75", false}
                  1 -> 
                    {"z-10 scale-[0.85] opacity-50 translate-x-[45%] blur-[2px] brightness-50 cursor-pointer hover:opacity-70 hover:brightness-75", false}
                  _ -> 
                    {"z-0 scale-[0.7] opacity-0 pointer-events-none translate-x-0", false}
                end
              %>

              <div 
                class={[
                  "absolute transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] w-[90%] max-w-[900px] aspect-video rounded-2xl overflow-hidden bg-black",
                  pos_classes
                ]}
                phx-click={!is_active && "set_slide"}
                phx-value-index={!is_active && index}
              >
                <%= if is_active do %>
                  <%!-- Active Player --%>
                  <.link navigate={~p"/watch/#{stream.streamer}"} class="relative block w-full h-full group/player">
                    <.video_player
                      id={"hero-player-#{stream.id}"}
                      url={stream.hls_url}
                      stream_id={stream.id}
                      is_live={true}
                      class="w-full h-full"
                    />
                    <%!-- Permanent LIVE Badge --%>
                    <div class="absolute top-4 left-4 z-40 pointer-events-none">
                      <span class="bg-[#eb0400] text-white text-[11px] font-bold px-2 py-0.5 rounded uppercase tracking-wider shadow-lg flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
                        LIVE
                      </span>
                    </div>
                    
                    <%!-- Click to Watch Overlay (Visible on Hover) --%>
                    <div class="absolute inset-0 bg-black/20 opacity-0 group-hover/player:opacity-100 transition-opacity flex items-center justify-center pointer-events-none z-10">
                       <div class="bg-slate-900/80 backdrop-blur-md px-4 py-2 rounded-full border border-white/10 text-white text-sm font-bold flex items-center gap-2 shadow-2xl scale-90 group-hover/player:scale-100 transition-transform">
                         <.svg variant="play" class="w-4 h-4" /> Watch Now
                       </div>
                    </div>
                  </.link>
                <% else %>
                  <%!-- Side Thumbnails --%>
                  <div class="w-full h-full relative">
                    <img src={stream.thumbnail_url} class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/20"></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Navigation Arrows -->
          <%= if length(@streams_data) > 1 do %>
            <button 
              phx-click="prev_slide"
              class="absolute left-8 z-50 p-4 rounded-full bg-black/40 hover:bg-black/60 border border-white/10 backdrop-blur-md text-white transition-all hover:scale-110 active:scale-95"
            >
              <.svg variant="chevron-left" class="w-8 h-8" />
            </button>
            <button 
              phx-click="next_slide"
              class="absolute right-8 z-50 p-4 rounded-full bg-black/40 hover:bg-black/60 border border-white/10 backdrop-blur-md text-white transition-all hover:scale-110 active:scale-95"
            >
              <.svg variant="chevron-right" class="w-8 h-8" />
            </button>
          <% end %>

        <% else %>
          <!-- Fallback for no live streams -->
          <div class="w-full h-full flex flex-col items-center justify-center glass-pane rounded-3xl mx-6 border-dashed border-2 border-white/10">
            <div class="p-6 rounded-full bg-white/5 mb-4">
              <.svg variant="video-camera-slash" class="w-12 h-12 text-slate-500" />
            </div>
            <h2 class="text-xl font-bold text-white uppercase tracking-tight italic">No one is live right now</h2>
            <p class="text-slate-400 text-sm mt-1">Check back later or explore other categories</p>
          </div>
        <% end %>
      </div>
    </section>

    <div class="px-6 py-8">
      <h1 class="font-title" >Live Now</h1>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6">
        <.card
          :for={card <- @streams_data}
          id={card.id}
          stream_name={card.stream_name}
          streamer={card.streamer}
          category={card.category}
          tags={card.tags}
          viewer_count={card.viewer_count}
          avatar={card.avatar}
          is_live={card.is_live}
          is_verified={card.is_verified}
          thumbnail_url={card.thumbnail_url}
        />
      </div>
      <h1 class="font-title mt-10 mb-4 text-xl">Categories</h1>
      <div class="relative group/cat px-4">
        <div 
          id="categories-scroll"
          class="flex gap-4 overflow-x-auto scroll-smooth no-scrollbar pb-4"
        >
          <%= for category <- @categories do %>
            <.link 
              navigate={~p"/directory/#{category.slug}"}
              class="flex-shrink-0 w-[180px] group/item"
            >
              <div class="relative aspect-[3/4] rounded-xl overflow-hidden mb-2 shadow-lg border border-white/5 transition-transform duration-300 group-hover/item:-translate-y-1">
                <img 
                  src={category.thumbnail_url} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover/item:scale-110" 
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover/item:opacity-100 transition-opacity"></div>
              </div>
              <h3 class="font-bold text-sm text-[#efeff1] truncate group-hover/item:text-blue-400 transition-colors">
                {category.name}
              </h3>
            </.link>
          <% end %>
        </div>

        <%!-- Scroll Buttons --%>
        <div class="absolute inset-y-0 left-0 flex items-center">
          <button 
            onclick="document.getElementById('categories-scroll').scrollBy({left: -400, behavior: 'smooth'})"
            class="p-2 rounded-full bg-slate-900/90 border border-white/10 text-white opacity-0 group-hover/cat:opacity-100 transition-opacity shadow-xl hover:scale-110 -ml-4 z-10"
          >
            <.svg variant="chevron-left" class="w-5 h-5" />
          </button>
        </div>
        
        <div class="absolute inset-y-0 right-0 flex items-center">
          <button 
            onclick="document.getElementById('categories-scroll').scrollBy({left: 400, behavior: 'smooth'})"
            class="p-2 rounded-full bg-slate-900/90 border border-white/10 text-white opacity-0 group-hover/cat:opacity-100 transition-opacity shadow-xl hover:scale-110 -mr-4 z-10"
          >
            <.svg variant="chevron-right" class="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
